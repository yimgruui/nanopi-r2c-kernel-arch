# NanoPi R2C (RK3328) router profile on top of ArchLinuxARM linux-aarch64.
# Derived from the upstream NanoPi R2S profile; the only board difference in
# the kernel config is the WAN PHY (Motorcomm YT8521S instead of RTL8211E).
#
# Invariant: this fragment keeps board/router features; trims live in fragment.prune.
# The two files are disjoint: prune never writes =n for a symbol enabled here.
#
# Required features (a change that drops any of these is a regression):
#   * PPPoE WAN            -> CONFIG_PPP=m, CONFIG_PPPOE=m
#   * eBPF tooling         -> BPF stack + CONFIG_DEBUG_INFO_BTF (needs pahole)
#   * ksmbd (SMB3 server)  -> CONFIG_SMB_SERVER=m
#   * NFS server (v3/v4)   -> CONFIG_NFSD=m, CONFIG_NFSD_V4=y
#   * R2C WAN PHY          -> CONFIG_MOTORCOMM_PHY=y
#
# Usage:
#   cp <ALARM-config> .config
#   make ARCH=arm64 olddefconfig
#   scripts/kconfig/merge_config.sh -m .config fragment.r2c
#   make ARCH=arm64 olddefconfig
#
# Dependency ordering (DO NOT REORDER):
#   Each group writes prerequisites before dependents so olddefconfig never
#   silently removes a symbol due to an unsatisfied depends-on chain.

# ---------------------------------------------------------------------------
# Kernel identity
# ---------------------------------------------------------------------------
CONFIG_LOCALVERSION=""

# ---------------------------------------------------------------------------
# RK3328 CPU (4x Cortex-A53)
# ---------------------------------------------------------------------------
CONFIG_NR_CPUS=4
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_845719=y

# ---------------------------------------------------------------------------
# Ethernet and router datapath
# ---------------------------------------------------------------------------
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y

# R2C note: on-board WAN PHY is Motorcomm YT8521S (R2S uses Realtek RTL8211E).
CONFIG_MOTORCOMM_PHY=y

CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_WIREGUARD=y
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_DRIVERS=y

# ---------------------------------------------------------------------------
# BPF stack — prerequisites first, then features
# ---------------------------------------------------------------------------

# --- base ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# --- tracing stack (hard deps of BPF_EVENTS) ---
CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_FUNCTION_TRACER=y
CONFIG_TRACEPOINTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y

# --- security (hard deps of BPF_LSM) ---
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y

# --- features ---
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_LWTUNNEL=y
CONFIG_LWTUNNEL_BPF=y
CONFIG_NETFILTER_BPF_LINK=y
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m

# --- LSM registration: keep baseline list, append ,bpf ---
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf"

# --- explicitly disabled ---
CONFIG_BPF_JIT_ALWAYS_ON=n
CONFIG_BPF_PRELOAD=n
CONFIG_HID_BPF=n

# ---------------------------------------------------------------------------
# Debug info + BTF (needed by eBPF / Landscape; compile-time dep: pahole/dwarves)
# ---------------------------------------------------------------------------
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO=y

# ---------------------------------------------------------------------------
# SRv6 / LWT — SEG6_BPF is def_bool y derived from SEG6_LWTUNNEL, do not write =n
# ---------------------------------------------------------------------------
CONFIG_IPV6_SEG6_LWTUNNEL=y

# ---------------------------------------------------------------------------
# PPPoE (user-space: pppd or rp-pppoe)
# ---------------------------------------------------------------------------
CONFIG_PPP=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_MPPE=m
CONFIG_PPPOE=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m

# ---------------------------------------------------------------------------
# USB host and storage
# ---------------------------------------------------------------------------
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
# The on-board RTL8153 LAN port hangs off the dwc3 USB3 controller, so host
# mode is required. Disabling USB gadget already collapses the mode choice to
# host-only, but state it explicitly so an ALARM rebase cannot flip it back to
# dual-role/gadget without this profile noticing.
CONFIG_USB_DWC3_HOST=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ---------------------------------------------------------------------------
# MMC, block storage, compressed swap
# ---------------------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_SWAP=y
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y
CONFIG_LZO_COMPRESS=m
CONFIG_LZO_DECOMPRESS=m

# ---------------------------------------------------------------------------
# Thermal, hwmon, and RTC
# ---------------------------------------------------------------------------
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=m
CONFIG_SENSORS_PWM_FAN=m
CONFIG_SENSORS_GPIO_FAN=m
CONFIG_SENSORS_INA2XX=m
CONFIG_SENSORS_INA3221=m
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_DRV_RK808=m
CONFIG_RTC_DRV_HYM8563=m

# ---------------------------------------------------------------------------
# Debug UART
# ---------------------------------------------------------------------------
CONFIG_SERIAL_8250_NR_UARTS=4

# ---------------------------------------------------------------------------
# LEDs, reset button, CPU power management
# ---------------------------------------------------------------------------
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=m
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y

# ---------------------------------------------------------------------------
# Removable-media filesystems
# ---------------------------------------------------------------------------
# ext4, VFAT, exFAT, overlayfs and FUSE come from the ALARM baseline.  Add only
# the common USB-disk filesystems; HFS/HFS+, ISO9660/UDF and SquashFS are rare
# on this appliance and stay disabled to keep the kernel package small.
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m

# ---------------------------------------------------------------------------
# NLS
# ---------------------------------------------------------------------------
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
# Common Chinese FAT codepages; UTF-8 (below) covers modern media.
CONFIG_NLS_CODEPAGE_936=m
CONFIG_NLS_CODEPAGE_950=m
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---------------------------------------------------------------------------
# ksmbd (SMB3 server) — depends/selects are auto-resolved by Kconfig;
#   only the top-level tristate needs to be written.
#   SMB_SERVER_SMBDIRECT stays unset (requires INFINIBAND, irrelevant on RK3328).
# ---------------------------------------------------------------------------
CONFIG_SMB_SERVER=m

# ---------------------------------------------------------------------------
# NFS server (v3 and v4) — the R2C exports the USB media share to LAN players.
#   CONFIG_NFSD selects SUNRPC/EXPORTFS/LOCKD/NFS_ACL_SUPPORT; NFSD_V4 selects
#   RPCSEC_GSS_KRB5, FS_POSIX_ACL and GRACE_PERIOD.  NFSv2 is deliberately off;
#   every client in this profile speaks v3 or v4.
# ---------------------------------------------------------------------------
CONFIG_NFSD=m
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y

# ---------------------------------------------------------------------------
# lz4
# ---------------------------------------------------------------------------
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_CRYPTO_LZ4=y
