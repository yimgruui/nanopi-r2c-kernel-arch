# NanoPi R2C/R2S (RK3328) router profile on top of ArchLinuxARM linux-aarch64.
#
# Invariant: this fragment keeps board/router features; trims live in fragment.prune.
#
# Merged AFTER fragment.prune. Actual build order: prune → r2c → olddefconfig.
# This fragment wins on any conflicting symbols.
#
# Usage:
#   cp <ALARM-config> .config
#   make ARCH=arm64 olddefconfig
#   scripts/kconfig/merge_config.sh -m .config fragment.prune
#   scripts/kconfig/merge_config.sh -m .config fragment.r2c
#   make ARCH=arm64 olddefconfig
#
# Dependency ordering (DO NOT REORDER):
#   Each group writes prerequisites before dependents so olddefconfig never
#   silently removes a symbol due to an unsatisfied depends-on chain.
#
# Build-contract symbols (verified against build script checks — DO NOT CHANGE):
#   WIREGUARD=y, IKCONFIG=y, IKCONFIG_PROC=y

# ---------------------------------------------------------------------------
# Kernel identity
# ---------------------------------------------------------------------------
CONFIG_LOCALVERSION=""

# ---------------------------------------------------------------------------
# RK3328 CPU (4x Cortex-A53)
# ---------------------------------------------------------------------------
CONFIG_NR_CPUS=4
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_845719=y

# ---------------------------------------------------------------------------
# Ethernet and router datapath
# ---------------------------------------------------------------------------
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y

# R2C note: on-board WAN PHY is Motorcomm YT8521S (R2S uses Realtek RTL8211E).
CONFIG_MOTORCOMM_PHY=y

CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
# WireGuard: build contract requires =y (do not demote to =m)
CONFIG_WIREGUARD=y
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_DRIVERS=y

# ---------------------------------------------------------------------------
# IKCONFIG — embedded config (build contract: IKCONFIG_PROC=y exposes
# /proc/config.gz; IKCONFIG_PROC depends on IKCONFIG, so enable the
# prerequisite explicitly to pin the dependency chain)
# ---------------------------------------------------------------------------
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---------------------------------------------------------------------------
# BPF stack — prerequisites first, then features
# ---------------------------------------------------------------------------

# --- base ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# --- tracing stack (hard deps of BPF_EVENTS) ---
CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_FUNCTION_TRACER=y
CONFIG_TRACEPOINTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y

# --- security (hard deps of BPF_LSM) ---
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y

# --- features ---
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_LWTUNNEL=y
CONFIG_LWTUNNEL_BPF=y
CONFIG_NETFILTER_BPF_LINK=y
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m

# --- LSM registration: keep baseline list, append ,bpf ---
#     Check baseline first: grep '^CONFIG_LSM=' <ALARM config>
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf"

# --- explicitly disabled ---
CONFIG_BPF_JIT_ALWAYS_ON=n
CONFIG_BPF_PRELOAD=n
CONFIG_HID_BPF=n

# ---------------------------------------------------------------------------
# Debug info + BTF (needed by eBPF / Landscape; compile-time dep: pahole/dwarves)
#
# Debug info is a Kconfig *choice*. If the baseline ALARM config carries
# DEBUG_INFO_NONE=y or DEBUG_INFO_REDUCED=y, that member is kept (first enabled
# in Kconfig order) and DEBUG_INFO_BTF vanishes entirely after olddefconfig.
# Therefore: disable all competitors FIRST, then enable the target.
# (Verified: both =n lines resolve cleanly on 7.3.1.)
# ---------------------------------------------------------------------------
CONFIG_DEBUG_INFO_NONE=n
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y

# ---------------------------------------------------------------------------
# SRv6 / LWT — SEG6_BPF is def_bool y derived from SEG6_LWTUNNEL, do not write =n
# ---------------------------------------------------------------------------
CONFIG_IPV6_SEG6_LWTUNNEL=y

# ---------------------------------------------------------------------------
# PPPoE (user-space: pppd or rp-pppoe)
# ---------------------------------------------------------------------------
CONFIG_PPP=m
CONFIG_SLHC=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_MPPE=m
CONFIG_PPPOE=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m

# ---------------------------------------------------------------------------
# ksmbd — SMB3 kernel server (module; SMB3 dialects only —
#   legacy algorithms ARC4/MD4/DES remain =n in fragment.prune)
# Dependency ordering: prerequisites first, then the feature.
# ---------------------------------------------------------------------------

# --- transport prerequisites ---
# INET / NF_CONNTRACK / NF_TABLES are already enabled above (router datapath).

# --- server core: module form to keep vmlinux small ---
CONFIG_SMB_SERVER=m

# --- crypto prerequisites (required by SMB3 encryption / signing / hashing) ---
CONFIG_CRYPTO_LIB_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# --- optional ARM64 CE acceleration (perf up / size up, off by default) ---
#CONFIG_CRYPTO_AES_ARM64_CE=y
#CONFIG_CRYPTO_AES_ARM64_CE_BLK=y

# --- explicitly disabled within ksmbd surface ---
CONFIG_SMB_SERVER_SMBDIRECT=n
CONFIG_SMB_SERVER_DEBUG=n

# ---------------------------------------------------------------------------
# USB host and storage
# ---------------------------------------------------------------------------
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ---------------------------------------------------------------------------
# MMC, block storage, compressed swap
# LZ4 backend + LZ4 default compressor for zram.
# LZO backend / LZO_COMPRESS / LZO_DECOMPRESS removed (volume saving).
# ---------------------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_SWAP=y
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_CRYPTO_LZ4=y

# ---------------------------------------------------------------------------
# Thermal, hwmon, and RTC
# ---------------------------------------------------------------------------
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=m
CONFIG_SENSORS_PWM_FAN=m
CONFIG_SENSORS_GPIO_FAN=m
CONFIG_SENSORS_INA2XX=m
CONFIG_SENSORS_INA3221=m
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_DRV_RK808=m
CONFIG_RTC_DRV_HYM8563=m

# ---------------------------------------------------------------------------
# Debug UART
# ---------------------------------------------------------------------------
CONFIG_SERIAL_8250_NR_UARTS=4

# ---------------------------------------------------------------------------
# LEDs, reset button, CPU power management
# ---------------------------------------------------------------------------
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=m
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y

# ---------------------------------------------------------------------------
# NLS
# ---------------------------------------------------------------------------
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---------------------------------------------------------------------------
# Size: compress modules on disk
#
# Kept COMMENTED OUT by default. First diagnose your kernel tree:
#   grep -rnE 'config MODULE_COMPRESS|config MODULE_DECOMPRESS' kernel/module/Kconfig
#
# If ALL THREE symbols exist and MODULE_DECOMPRESS depends on MODULE_COMPRESS,
# uncomment in prerequisite order (outer switch first):
#   CONFIG_MODULE_COMPRESS=y       <- outer switch, prerequisite of the choice
#   CONFIG_MODULE_COMPRESS_XZ=y    <- choice member
#   CONFIG_MODULE_DECOMPRESS=y     <- load-time decompression support
#
# If MODULE_DECOMPRESS is absent from your tree, keep ALL THREE commented —
# enabling compression without decompression produces .ko.xz the kernel
# cannot load. Use install-time stripping instead:
#   make INSTALL_MOD_STRIP=1 modules_install
# ---------------------------------------------------------------------------
#CONFIG_MODULE_COMPRESS=y
#CONFIG_MODULE_COMPRESS_XZ=y
#CONFIG_MODULE_DECOMPRESS=y
