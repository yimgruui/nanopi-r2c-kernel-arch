# NanoPi R2S (RK3328) router profile on top of ALARM linux-aarch64.
# Invariant: this fragment keeps board/router features; trims live in fragment.prune.

# ---------------------------------------------------------------------------
# Kernel identity
# ---------------------------------------------------------------------------
CONFIG_LOCALVERSION=""

# ---------------------------------------------------------------------------
# RK3328 CPU
# ---------------------------------------------------------------------------
CONFIG_NR_CPUS=4
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_845719=y
CONFIG_ARM64_ERRATUM_843419=y

# ---------------------------------------------------------------------------
# Ethernet and router datapath
# ---------------------------------------------------------------------------
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
# R2C note: the on-board WAN PHY is a Motorcomm YT8521S (the R2S uses a Realtek
# RTL8211E), so CONFIG_MOTORCOMM_PHY is mandatory. CONFIG_DEBUG_INFO_BTF is
# required by eBPF programs (e.g. Landscape); needs pahole at build time.
# If the ALARM baseline selects DEBUG_INFO_NONE, also add:
CONFIG_DEBUG_INFO_NONE=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_LSM=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_LWTUNNEL=y
CONFIG_LWTUNNEL_BPF=y
CONFIG_IPV6_SEG6_LWTUNNEL=y   # SEG6_BPF is def_bool y, auto-enabled with this
CONFIG_NETFILTER_BPF_LINK=y
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
# Documented as disabled:
CONFIG_BPF_JIT_ALWAYS_ON=n
CONFIG_BPF_PRELOAD=n
CONFIG_HID_BPF=n
# Keep the internal RTL8153 LAN driver modular so its firmware is available from rootfs.
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_WIREGUARD=y

CONFIG_PERF_EVENTS=y          # dependency of CONFIG_BPF_EVENTS (prune may cut it)
CONFIG_SECURITYFS=y           # dependency of CONFIG_BPF_LSM

# PPPoE (common ISP dial-up; userland needs pppd or rp-pppoe)
CONFIG_PPP=m
CONFIG_SLHC=m
CONFIG_PPP_BSDCOMP=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_MPPE=m
CONFIG_PPPOE=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m


# ---------------------------------------------------------------------------
# USB host and storage
# ---------------------------------------------------------------------------
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ---------------------------------------------------------------------------
# MMC, block storage, and optional compressed swap
# ---------------------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
# Ship zram as an opt-in module; userspace remains responsible for configuring it.
CONFIG_SWAP=y
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y
CONFIG_LZO_COMPRESS=m
CONFIG_LZO_DECOMPRESS=m

# ---------------------------------------------------------------------------
# Thermal, hwmon, and RTC
# ---------------------------------------------------------------------------
CONFIG_HWMON=y
CONFIG_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=m
CONFIG_SENSORS_PWM_FAN=m
CONFIG_SENSORS_GPIO_FAN=m
CONFIG_SENSORS_INA2XX=m
CONFIG_SENSORS_INA3221=m
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_DRV_RK808=m
CONFIG_RTC_DRV_HYM8563=m

# ---------------------------------------------------------------------------
# Debug UART
# ---------------------------------------------------------------------------
CONFIG_SERIAL_8250_NR_UARTS=4

# ---------------------------------------------------------------------------
# LEDs, reset button, and CPU power management
# ---------------------------------------------------------------------------
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=m
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y

# ---------------------------------------------------------------------------
# Locales and userspace compatibility
# ---------------------------------------------------------------------------
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SECURITY_LANDLOCK=y
