---
extends: default

rules:
  line-length:
    max: 160
    # Long embedded shell/jq lines are unavoidable in workflow files; report
    # them without failing the lint job.
    level: warning
  document-start: disable
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
